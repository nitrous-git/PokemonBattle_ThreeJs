{
  "name": "nitrous-battle-atelier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static Three.js Pokémon battle simulator using browser-native ES modules and a pinned Three.js CDN import map.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "serve": "node scripts/static-server.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-qa.mjs",
    "lint": "eslint src scripts tests",
    "format": "prettier --write \"src/**/*.js\" \"src/**/*.html\" \"src/**/*.css\" \"scripts/**/*.mjs\" \"tests/**/*.js\"",
    "data:import": "node scripts/import-pokeapi.mjs",
    "data:compile": "node scripts/compile-content.mjs",
    "data:validate": "node scripts/validate-content.mjs",
    "assets:prepare": "node scripts/prepare-sprites.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "assets:standins": "node scripts/prepare-sprites.mjs --standins"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.56.1",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "sharp": "0.34.4",
    "three": "0.180.0",
    "vitest": "3.2.4"
  }
}
